# Nova Home Dashboard — настройки. Скопируйте в .env и заполните.
# Строки с # — комментарии. Пустое значение = функция выключена / значение по умолчанию.

# ---- RealtyCalendar ---------------------------------------------------------
RC_TOKEN=                       # x-user-token из RealtyCalendar (пусто = демо-режим)
RC_COOKIES=                     # cookies строкой "k=v; k2=v2" (если RC требует)
SYNC_INTERVAL_MINUTES=15        # как часто тянуть брони
SYNC_DAYS_AHEAD=60              # на сколько дней вперёд зеркалить брони

# ---- Telegram ---------------------------------------------------------------
BOT_TOKEN=                      # токен от @BotFather
WEBAPP_URL=https://app.novahomedashboard.com   # адрес дашборда (Cloudflare Tunnel)
OWNER_IDS=                      # Telegram ID владельцев через запятую (узнать: /myid)
OWNER_KEY=                      # любой длинный секрет: открывает режим владельца на macOS Telegram
NOTIFY_CHAT_IDS=                # ID рабочей группы (узнать: /chatid в группе), можно несколько через запятую
PAY_CHANNEL_IDS=                # ID канала оплат (бот должен быть админом канала)
PAY_VIEWERS=                    # кто ещё видит блок «Оплаты»: ID или @username через запятую
PAY_KEY=                        # секрет для PAY_VIEWERS на macOS
STAFF_KEY=                      # можно не задавать — выводится из BOT_TOKEN автоматически
STAFF_IDS=                      # необязательно: "123:Имя, 456:Имя" — сотрудники и так регистрируются сами

# ---- Явка (live-локация) ----------------------------------------------------
WORK_LAT=41.311899              # координаты объекта (владелец: отправить боту обычную геопозицию)
WORK_LNG=69.251689
WORK_RADIUS_M=300               # радиус зоны, м
SHIFT_START=11:00               # начало смены
SHIFT_GRACE_MIN=20              # допустимое опоздание, мин
ATTEND_REMIND=10:00             # напоминание в личку
ATTEND_EARLIEST=09:00           # с какого времени принимать локацию
ATTEND_DEADLINE=14:00           # до какого времени; в это же время — перекличка в группу
AUTO_FINE_NOSHOW=50000          # автоштраф за неявку, сум (0 = выключить)

# ---- Уборки -----------------------------------------------------------------
CLEANING_CHECK=18:00            # контроль уборок в тему «Уборки» + список закупок владельцу
SESSION_MAX_HOURS=8             # уборка без отчёта «после» дольше этого закрывается автоматически

# ---- Уведомления о падении ---------------------------------------------------
# Сервер и бот следят друг за другом сами и пишут владельцу в личку.
# Чтобы узнавать и о выключенном компьютере/интернете, нужен внешний
# наблюдатель: healthchecks.io (бесплатно). Создайте там две проверки
# (период 2 мин, запас 5 мин), подключите Telegram и вставьте ping-ссылки:
HEARTBEAT_URL_BOT=              # https://hc-ping.com/xxxxxxxx-....
HEARTBEAT_URL_SERVER=           # https://hc-ping.com/yyyyyyyy-....
BOT_DOWN_AFTER_MIN=3            # через сколько минут тишины бота сервер бьёт тревогу

# ---- Чаты WhatsApp (свой Wazzup) ---------------------------------------------
# Окно «Nova WhatsApp» (wa-bridge, нужен Node.js) держит связь с WhatsApp;
# привязка — QR-код в «Чатах». Всё ниже можно не заполнять.
INBOX_USERS=                    # кто работает в чатах кроме владельцев: ID или @username; пусто = все сотрудники из /staff
INBOX_NOTIFY_CHAT_IDS=          # куда слать «💬 новое сообщение» (ответ reply-ем уйдёт гостю); пусто = владельцам, 0 = выключить
INBOX_HISTORY_DAYS=30           # сколько дней истории подтянуть с телефона при первой привязке
WA_BRIDGE_PORT=8100             # порт моста (только внутри компьютера)
INBOX_SECRET=                   # пусто = выводится из BOT_TOKEN автоматически

# ---- Каналы в CRM → «Каналы» (все необязательны) ------------------------------
# Wazzup (wazzup24.ru): Настройки → Интеграция с CRM → Ключ API. Входящие приходят
# на вебхук {WEBAPP_URL}/api/inbox/wazzup/webhook/… — он регистрируется сам при запуске.
WAZZUP_API_KEY=
WAZZUP_CHANNEL_ID=              # необязательно: id канала WhatsApp в Wazzup, если их несколько
# WhatsApp Cloud API (официально, через Meta) и Instagram Direct — один вебхук:
#   {WEBAPP_URL}/api/inbox/meta/webhook   (verify token — META_VERIFY_TOKEN)
META_VERIFY_TOKEN=              # любое слово, то же вписать в настройках вебхука Meta
META_APP_SECRET=                # App secret приложения Meta — проверка подписи вебхуков (обязательно для боевого режима)
WA_CLOUD_TOKEN=                 # постоянный токен (System user) с правом whatsapp_business_messaging
WA_CLOUD_PHONE_ID=              # Phone number ID из WhatsApp → API Setup
IG_PAGE_TOKEN=                  # Page access token Facebook-страницы, к которой привязан Instagram
# Telegram — аккаунт компании (личные чаты, как в Wazzup): my.telegram.org → API development tools
TG_API_ID=
TG_API_HASH=
# Telegram-бот для гостей (отдельный от рабочего бота!)
TG_GUEST_BOT_TOKEN=

# ---- CRM (сайт для офиса: WEBAPP_URL/crm/) ------------------------------------
# Первый администратор. Можно не заполнять — при первом открытии /crm/ страница
# сама предложит создать администратора.
CRM_ADMIN_EMAIL=
CRM_ADMIN_PASSWORD=

# ---- Email из CRM (счета, подтверждения брони) --------------------------------
# Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=587, SMTP_USER=ваш@gmail.com,
# SMTP_PASSWORD — «пароль приложения» (Google-аккаунт → Безопасность → Пароли приложений)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=                      # адрес отправителя (по умолчанию SMTP_USER)
SMTP_FROM_NAME=Nova Home

# ---- Тишина -----------------------------------------------------------------
QUIET_FROM=01:00                # в этом окне все сообщения бота приходят без звука
QUIET_TO=08:00

# ---- Касса (Google Sheet через Apps Script) ---------------------------------
SHEET_API_URL=
SHEET_API_TOKEN=
FINANCE_CACHE_TTL=60

# ---- Прочее -----------------------------------------------------------------
DB_PATH=                        # путь к базе SQLite (по умолчанию nova_dashboard.db в папке проекта)
DEMO_MODE=                      # 1 = сгенерированные данные вместо RC
